{
  "inbounds": [
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "0.0.0.0",
      "listen_port": 7893
    },
    {
      "type": "direct",
      "tag": "dns-in",
      "listen": "0.0.0.0",
      "listen_port": 53
    }
  ],
  "route": {
    "rules": [
      {"inbound": ["dns-in"], "action": "hijack-dns"},
      {"type": "logical", "mode": "and", "rules": [{"network": "udp"}, {"port": 443}], "action": "reject", "no_drop": true},
      {"action": "sniff", "timeout": "300ms"},
      {"rule_set": "ad-site", "action": "reject"},
      {"rule_set": "reject-site", "action": "reject"},
      {"rule_set": "ad-ip", "action": "reject"},
      {"rule_set": "huawei-site", "action": "reject"},
      {"rule_set": "huawei-ip", "action": "reject"},
      {"domain": ["ntp.aliyun.com"], "outbound": "D"},
      {"domain_keyword": ["msftconnecttest.com", "msftncsi.com"], "outbound": "Microsoft"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.7/32"}, {"domain_keyword": "googleapis"}], "outbound": "Youtube"},
      {"domain_keyword": "googleapis", "outbound": "Google"},
      {"rule_set": "direct-site", "outbound": "D"},
      {"rule_set": "docker-site", "outbound": "M"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.21/32"}, {"rule_set": "cloudflare-site"}], "outbound": "D"},
      {"rule_set": "cloudflare-site", "outbound": "M"},
      {"rule_set": "proxy-site", "outbound": "M"},
      {"rule_set": "openai-site", "outbound": "OpenAi"},
      {"rule_set": "pikpak-site", "outbound": "PikPak"},
      {"rule_set": "javdb-site", "outbound": "M"},
      {"rule_set": "tmdb-site", "outbound": "M"},
      {"rule_set": "speedtest-site", "outbound": "M"},
      {"rule_set": "codeberg-site", "outbound": "GitHub"},
      {"rule_set": "f-droid-site", "outbound": "M"},
      {"rule_set": "adguard-site", "outbound": "M"},
      {"rule_set": "archlinux-site", "outbound": "M"},
      {"rule_set": "steam-site", "outbound": "Steam"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.7/32"}, {"rule_set": "youtube-site"}], "outbound": "Youtube"},
      {"rule_set": "youtube-site", "outbound": "Google"},
      {"rule_set": "tiktok-site", "outbound": "JP"},
      {"rule_set": "github-site", "outbound": "GitHub"},
      {"rule_set": "mozilla-site", "outbound": "M"},
      {"rule_set": "googlefcm-site", "outbound": "D"},
      {"rule_set": "telegram-site", "outbound": "Telegram"},
      {"rule_set": "twitter-site", "outbound": "Twitter"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.7/32"}, {"rule_set": "google-site"}], "outbound": "Youtube"},
      {"rule_set": "google-site", "outbound": "Google"},
      {"rule_set": "tencent-site", "outbound": "D"},
      {"rule_set": "microsoft-site", "outbound": "Microsoft"},
      {"rule_set": "gfw-site", "outbound": "M"},
      {"rule_set": "cn-site", "outbound": "D"},
      {"action": "resolve", "server": "dns_proxy"},
      {"rule_set": "direct-ip", "outbound": "D"},
      {"rule_set": "wechat-ip", "outbound": "D"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.21/32"}, {"rule_set": "cloudflare-ip"}], "outbound": "D"},
      {"rule_set": "cloudflare-ip", "outbound": "M"},
      {"rule_set": "pikpak-ip", "outbound": "PikPak"},
      {"rule_set": "twitter-ip", "outbound": "Twitter"},
      {"rule_set": "telegram-ip", "outbound": "Telegram"},
      {"type": "logical", "mode": "and", "rules": [{"source_ip_cidr": "10.0.0.7/32"}, {"rule_set": "google-ip"}], "outbound": "Youtube"},
      {"rule_set": "google-ip", "outbound": "Google"},
      {"rule_set": "cn-ip", "outbound": "D"}
    ],
    "rule_set": [
      {
        "tag": ["ad-site", "adguard-site", "archlinux-site", "cn-site", "codeberg-site", "cloudflare-site", "docker-site", "f-droid-site", "gfw-site", "github-site", "google-site", "googlefcm-site", "javdb-site", "microsoft-site", "mozilla-site", "openai-site", "reject-site", "speedtest-site", "steam-site", "tencent-site", "telegram-site", "tiktok-site", "tmdb-site", "twitter-site", "youtube-site", "direct-site", "huawei-site", "pikpak-site", "proxy-site", "ad-ip", "cn-ip", "cloudflare-ip", "google-ip", "telegram-ip", "twitter-ip", "direct-ip", "huawei-ip", "pikpak-ip", "wechat-ip"],
        "type": "remote",
        "url": "https://rules.346211.xyz/{tag}.srs",
        "update_interval": "12h0m0s"
      }
    ],
    "final": "Default",
    "default_mark": 666,
    "default_domain_resolver": {"server": "dns_direct", "rewrite_ttl": 10}
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_fakeip": true,
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "10.0.0.1:9090",
      "external_ui": "ui",
      "external_ui_download_url": "https://www.346211.xyz/dist_openwrt.zip",
      "external_ui_download_detour": "D",
      "default_mode": "rule"
    }
  }
}
